<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LumikitApp.Controls.TimelineView">
    <ScrollViewer x:Name="TimelineScrollViewer"
                  HorizontalScrollBarVisibility="Visible"
                  VerticalScrollBarVisibility="Disabled"
                  Height="130">
        <Grid>
            <Canvas x:Name="TimelineCanvas" Height="80" Margin="0,20,0,0"/>
            <Canvas x:Name="BpmCanvas" Height="80" Margin="0,20,0,0" IsHitTestVisible="False"/>
            <Canvas x:Name="SeekBarCanvas" Height="20" VerticalAlignment="Top" Background="#337F77DD"/>
        </Grid>
    </ScrollViewer>
</UserControl>
