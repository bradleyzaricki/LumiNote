# Copy this file to `.env` (which is gitignored) and fill in real values.
# Loaded by DotNetEnv in Program.Main.

# Google OAuth 2.0 "Desktop app" client — create at:
#   console.cloud.google.com → APIs & Services → Credentials → OAuth client ID → Desktop app
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
