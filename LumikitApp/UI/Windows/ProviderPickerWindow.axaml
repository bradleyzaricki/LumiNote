<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LumikitApp.ProviderPickerWindow"
        Width="420"
        Height="280"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Title="Choose playback"
        Background="#2E2E2E">

    <Window.Styles>
        <!-- Highlight the icon when its provider is enabled -->
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="ToggleButton:checked">
            <Setter Property="BorderBrush" Value="#1DB954"/>
            <Setter Property="Background" Value="#454545"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="16" Spacing="16">
        <TextBlock FontSize="18"
                   Text="Select your playback sources"
                   Foreground="White"
                   HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="24">

            <ToggleButton Name="SpotifyToggle"
                          FocusAdorner="{x:Null}"
                          IsCheckedChanged="Toggle_Changed">
                <Image Source="avares://LumikitApp/Icons/spotify_icon_black.png"
                       Width="96"
                       Height="96"
                       Stretch="Uniform"/>
            </ToggleButton>

            <ToggleButton Name="LocalToggle"
                          FocusAdorner="{x:Null}"
                          IsCheckedChanged="Toggle_Changed">
                <Image Source="avares://LumikitApp/Icons/file_icon.png"
                       Width="96"
                       Height="96"
                       Stretch="Uniform"/>
            </ToggleButton>

        </StackPanel>

        <Button Name="ContinueButton"
                Content="Continue"
                HorizontalAlignment="Center"
                Padding="24,8"
                IsEnabled="False"
                Click="Continue_Click"/>
    </StackPanel>

</Window>
