<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LumikitApp.NewTrackPopup"
        Width="400"
        Height="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Save Lightmap">

    <StackPanel Margin="20" Spacing="12">

        <TextBlock Text="Lightmap Name"/>
        <TextBox x:Name="LightmapBox" Watermark="e.g. Chill sunset mix"/>

        <TextBlock Text="Track Name"/>
        <TextBox x:Name="TitleBox" Watermark="The song's title"/>

        <TextBlock Text="Artist"/>
        <TextBox x:Name="ArtistBox" Watermark="Artist / band"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,10,0,0">

            <Button Content="Cancel"
                    Width="80"
                    Click="Cancel_Click"/>

            <Button Content="OK"
                    Width="80"
                    Click="Ok_Click"/>
        </StackPanel>

    </StackPanel>
</Window>