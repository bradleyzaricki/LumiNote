<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LumikitApp.Controls"
        xmlns:rs="clr-namespace:RangeSlider.Avalonia.Controls;assembly=RangeSlider.Avalonia"
        xmlns:models="clr-namespace:LumikitApp.Models"
        xmlns:vm="clr-namespace:LumikitApp.ViewModels"
        x:Class="LumikitApp.LumikitWindow"
        Width="1600" Height="900"
        Background="Black"
        Title="LumiNote Software V1">
    <Window.Resources>
        <Flyout x:Key="OpenAudioFlyout" Placement="Bottom">
            <Border Background="#222" Padding="12" CornerRadius="8">
                <StackPanel Width="320" Spacing="10">
                    <TextBlock Text="Open Audio File" FontSize="16" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Choose an mp3/wav/flac file." Foreground="#AAA"/>

                    <Button Content="Browse…" Click="BrowseAudioFile_Click"/>

                    <TextBlock Name="SelectedAudioPathText"
                               Text="No file selected"
                               Foreground="#888"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Flyout>

        <Flyout x:Key="NewLightmapSourceFlyout" Placement="Bottom">
            <Border Background="#222" Padding="12" CornerRadius="8">
                <StackPanel Width="260" Spacing="8">
                    <TextBlock Text="New Lightmap From…" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Choose the source for this lightmap." Foreground="#AAA"/>
                    <Button Content="Local Audio File…"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="PickLocalSource_Click"/>
                    <Button Content="Spotify — Currently Playing"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="PickSpotifySource_Click"/>
                </StackPanel>
            </Border>
        </Flyout>

        <Flyout x:Key="SwatchPickerFlyout" Placement="Bottom">
            <Border Background="#222" Padding="10" CornerRadius="8">
                <ColorPicker x:Name="SwatchFlyoutPicker"
                             Width="260"
                             Height="220"
                             ColorSpectrumShape="Ring"
                             IsColorSpectrumSliderVisible="False"
                             IsAlphaEnabled="False"/>
            </Border>
        </Flyout>

        <Flyout x:Key="HardwareSettingsFlyout" Placement="Bottom">
            <Border Background="#222" Padding="12" CornerRadius="8">
                <StackPanel Width="280" Spacing="10">

                    <TextBlock Text="Hardware Settings" FontSize="16" FontWeight="Bold" Foreground="White"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Number Leds" Foreground="#DDD"/>
                        <TextBox Watermark="ex. 300 LEDS" Name="ActiveLightsTextBox"></TextBox>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Input Current" Foreground="#DDD"/>

                            <Slider Name="HardwareCurrentSlider"
                                    Minimum="0"
                                    Maximum="40"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"/>

                            <TextBlock Text="{Binding #HardwareCurrentSlider.Value, StringFormat={}{0:0} A}"
                                       HorizontalAlignment="Left"
                                       Foreground="#AAA"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="USB / Serial Device"/>

                        <ComboBox Name="PortComboBox"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Refresh" Click="RefreshPorts"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Save Changes" Foreground="#DDD"/>
                        <Button Content="Save" Width="80" Click="SaveHardwareSettings"></Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Flyout>
    </Window.Resources>

    <Window.Styles>
        <!-- Shared track-row action buttons: consistent size, rounding, and hover -->
        <Style Selector="Button.trackAction">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#2c2c2c"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.trackAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3d3d3d"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Primary action (Play / Download) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1DB954"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1ed760"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Destructive action (Delete) -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ff6b6b"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5a2424"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Source badge pill -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Thin divider between action groups -->
        <Style Selector="Border.actionDivider">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#454545"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="MainGrid" ColumnDefinitions="*, Auto" RowDefinitions="Auto,Auto,*,Auto" Margin="10">

        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <Button Name="PauseTrackButton" Content="Pause" Width="80"/>
            <Button Name="ResumeTrackButton" Content="Resume" Width="80"/>
            <Button Name="NextTrackButton" Content="Next" Width="80"/>
            <Button Name="RestartTrackButton" Content="Restart" Width="80"/>
            <Button Name="ZoomInButton" Content="+" Width="40"/>
            <Button Name="ZoomOutButton" Content="-" Width="40"/>

            <TextBlock Name="StopwatchLabel" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBlock Text="BPM:" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBox Name="BpmInput" Width="60" Text="120"/>
            <Button Name="SaveTrackDataButton" Content="Save New" Width="100"/>
            <Button Name="OpenAudioFileButton"
                    Content="New Lightmap"
                    Width="250"
                    Click="OpenAudioFileButton_OnClick"/>

            <Button Name="HardwareSettings"
                    Content="Hardware Settings"
                    Width="150"
                    Background="BlueViolet"
                    Click="HardwareSettingsOnClick"
                    Flyout="{StaticResource HardwareSettingsFlyout}"/>
            <TextBlock Name="HardwareConnectionText" Text="Serial Disconnected" VerticalAlignment="Center"></TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Image Name="AlbumArt" Width="60" Height="60"/>

            <StackPanel Orientation="Vertical" Margin="10,0,0,0">
                <TextBlock Text="title:" Foreground="White" FontSize="8"/>
                <TextBlock Name="NowPlayingTrackText" Foreground="White" FontSize="16"/>

                <TextBlock Text="artist:" Foreground="White" FontSize="8" Margin="0,4,0,0"/>
                <TextBlock Name="NowPlayingArtistText" Foreground="White" FontSize="16"/>
            </StackPanel>

            <Image Name="SpotifyAttributionLogo"
                   Source="avares://LumikitApp/Icons/spot_white_logo_full.png"
                   Width="120"
                   
                   Margin="30,0,10,10"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   IsVisible="True"/>
        </StackPanel>

        <Grid Grid.Column="0" Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

            <Border Grid.Row="0" Name="TopColorBar" Height="5" Background="Gray"/>

            <local:TimelineView x:Name="Timeline" Grid.Row="1" Height="130"/>

            <Border Grid.Row="2" Name="BottomColorBar" Height="5" Background="Gray"/>

            <WrapPanel Grid.Row="3"
                       Name="ColorPalette"
                       Orientation="Horizontal"
                       Margin="0,10,0,0"
                       Height="40"/>

            <Border Grid.Row="4" Height="1" Background="#333" Margin="0,20,0,10"/>
            

            <TabControl x:Name="MainTabControl" Grid.Row="6" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Tracks" Margin="0,10,0,0">
                    <TabControl>
                        <TabItem Header="Local Tracks" Margin="0,10,0,0">
                        <Grid Margin="0,0,0,0" RowDefinitions="Auto,*">

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox x:Name="LocalTrackSearchBox"
                                         Width="320"
                                         Watermark="Search tracks by name or ID..."
                                         HorizontalAlignment="Left"
                                         TextChanged="LocalTrackSearchBox_TextChanged"/>

                                <Button Content="Refresh"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        Click="RefreshLocalTracks_Click"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="#1b1b1b"
                                    CornerRadius="6"
                                    Padding="10">

                                <ListBox x:Name="LocalTracksListBox"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </ListBox.Styles>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TrackItemUI">
                                            <Border Background="{Binding Color, Converter={StaticResource DarkenConverter}}"
                                                    CornerRadius="8"
                                                    Padding="14,8"
                                                    Margin="0,0,0,6"
                                                    Height="68"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{Binding Color}">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch">

                                                    <!-- Track info + source badges -->
                                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TrackName}"
                                                                       Foreground="White"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <ItemsControl ItemsSource="{Binding SourceBadges}"
                                                                          VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:ProviderBadge">
                                                                        <Border Classes="badge" Background="{Binding Color}">
                                                                            <TextBlock Text="{Binding Name}"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   Foreground="#9a9a9a"
                                                                   FontSize="12"/>
                                                    </StackPanel>

                                                    <!-- Actions: primary play | link group | delete -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                Spacing="6" VerticalAlignment="Center">
                                                        <Button Classes="trackAction primary" Content="▶"
                                                                ToolTip.Tip="Play"
                                                                Click="LocalTrack_Play_Click"/>

                                                        <Button Classes="trackAction" Content="⤒"
                                                                ToolTip.Tip="Queue next (top of queue)"
                                                                Click="LocalTrack_QueueTop_Click"/>
                                                        <Button Classes="trackAction" Content="⤓"
                                                                ToolTip.Tip="Add to end of queue"
                                                                Click="LocalTrack_QueueBottom_Click"/>

                                                        <Border Classes="actionDivider"/>

                                                        <ItemsControl ItemsSource="{Binding LinkActions}"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:TrackLinkAction">
                                                                    <Button Classes="trackAction"
                                                                            Content="{Binding Label}"
                                                                            Click="LocalTrack_Link_Click"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Classes="trackAction" Content="Upload"
                                                                ToolTip.Tip="Upload this lightmap to the shared library"
                                                                Click="LocalTrack_Upload_Click"/>

                                                        <Border Classes="actionDivider"/>

                                                        <Button Classes="trackAction danger" Content="🗑"
                                                                ToolTip.Tip="Delete this lightmap"
                                                                Click="LocalTrack_Delete_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </Border>

                        </Grid>
                    </TabItem>
                        


        <!-- Downloaded Local Tracks -->
            


            <!-- QUEUE -->
            <TabItem Header="Queue">
                <Grid Margin="0,10,0,0" RowDefinitions="Auto,*">

                    <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Up Next" FontSize="16" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QueueCountText" Text="Queue is empty"
                                   Foreground="#9a9a9a" VerticalAlignment="Center"/>
                        <Button Classes="trackAction" Content="Clear"
                                ToolTip.Tip="Remove all tracks from the queue"
                                Click="QueueClear_Click"/>
                    </StackPanel>

                    <!-- Rows drag-reorder with the pointer: handlers live in code-behind. -->
                    <Border Grid.Row="1" Background="#1b1b1b" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="QueueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:QueueEntry">
                                        <Border Background="{Binding Color, Converter={StaticResource DarkenConverter}}"
                                                BorderBrush="{Binding Color}"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                Padding="14,8"
                                                Margin="0,0,0,6"
                                                Height="60"
                                                Cursor="Hand"
                                                PointerPressed="QueueRow_PointerPressed"
                                                PointerMoved="QueueRow_PointerMoved"
                                                PointerReleased="QueueRow_PointerReleased">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="☰" Foreground="#777"
                                                           FontSize="16" VerticalAlignment="Center"
                                                           Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TrackName}" Foreground="White"
                                                               FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#9a9a9a"
                                                               FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="trackAction danger" Content="✕"
                                                        ToolTip.Tip="Remove from queue"
                                                        Click="QueueRemove_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        
            <!-- DB TRACKS -->
            <TabItem Header="Download Tracks">
                <Grid Margin="0,10,0,0" RowDefinitions="Auto,*" ColumnSpacing="10">

                    <!-- Search + Refresh ABOVE LIST, LEFT ALIGNED -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="0">
                        <TextBox Width="320"
                                 Watermark="Search tracks..."
                                 HorizontalAlignment="Left"/>
                        <Button Content="Refresh"
                                Width="100"
                                HorizontalAlignment="Left"                                
                                Click="DatabaseTrack_Refresh_Click"/>
                    </StackPanel>

                    <!-- Scrollable List -->
                    <Border Grid.Row="1"
                            Background="#1b1b1b"
                            CornerRadius="6"
                            Padding="10">
                        <ListBox x:Name="DatabaseTracksListBox"  
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TrackItemUI">
                                    <Border Background="{Binding Color, Converter={StaticResource DarkenConverter}}"
                                            CornerRadius="8"
                                            Padding="14,8"
                                            Margin="0,0,0,6"
                                            Height="68"
                                            BorderThickness="1.5"
                                            BorderBrush="{Binding Color}">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TrackName}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <ItemsControl ItemsSource="{Binding SourceBadges}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ProviderBadge">
                                                                <Border Classes="badge" Background="{Binding Color}">
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#9a9a9a" FontSize="12"/>
                                            </StackPanel>
                                            <Button Classes="trackAction primary" Grid.Column="1"
                                                    Content="Download"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    ToolTip.Tip="Download this lightmap to your local library"
                                                    Click="DatabaseTrack_Download_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                </Grid>
            </TabItem>
            </TabControl>
            </TabItem>
                <TabItem Header="Light Preview" Margin="0,10,0,0">

                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Top controls -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="10"
                                    Spacing="10">

                            <TextBlock Text="Selected Block Simulator"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="10" Background="#222">

                                <!-- LED BACKGROUND -->
                                <local:LedStripPreview
                                    x:Name="LedPreview"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>

                                <!-- LIGHTBLOCK SETTINGS -->
                                <ScrollViewer HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Margin="30,25"
                                              ZIndex="10"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <!-- LIGHTSPAN -->
                                    
                                    <StackPanel  Name="LightRange" Grid.Row="0" Margin="0,10" IsVisible="{Binding LightRangeVisible}">
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="LightSpan"/>
                                            <TextBlock Text="{Binding #LightRangeSlider.LowerSelectedValue, StringFormat='Start: {0:0}'}" Foreground="#AAA"/>
                                            <TextBlock Text="{Binding #LightRangeSlider.UpperSelectedValue, StringFormat='End: {0:0}'}"   Foreground="#AAA"/>
                                        </StackPanel>
                                        <rs:RangeSlider x:Name="LightRangeSlider"
                                                        Minimum="0" Maximum="1000"
                                                        LowerSelectedValue="{Binding LightRangeLower, Mode=TwoWay}"
                                                        UpperSelectedValue="{Binding LightRangeUpper, Mode=TwoWay}">
                                            <rs:RangeSlider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="BlueViolet"/>
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="BlueViolet"/>
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="BlueViolet"/>
                                            </rs:RangeSlider.Resources>
                                        </rs:RangeSlider>
                                    </StackPanel>
                                    
                                    <!-- LIGHTSPAN 2In1 -->

                                    <StackPanel Name="LightRange2" Grid.Row="1" Margin="0,10" Spacing="6" IsVisible="{Binding LightRange2Visible}">

                                        <Grid ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,10,0" Spacing="2">
                                                <TextBlock Name="RangeSlider1Text" Text="{Binding RangeSlider1Label}" TextAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding #LightRange2Slider1.LowerSelectedValue, StringFormat='S:{0:0}'}" Foreground="#AAA" FontSize="11"/>
                                                    <TextBlock Text="{Binding #LightRange2Slider1.UpperSelectedValue, StringFormat='E:{0:0}'}"   Foreground="#AAA" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <rs:RangeSlider x:Name="LightRange2Slider1"
                                                            Grid.Column="1"
                                                            Minimum="0" Maximum="1000"
                                                            LowerSelectedValue="{Binding Range2Slider1Lower, Mode=TwoWay}"
                                                            UpperSelectedValue="{Binding Range2Slider1Upper, Mode=TwoWay}">
                                                <rs:RangeSlider.Resources>
                                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="BlueViolet"/>
                                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="BlueViolet"/>
                                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="BlueViolet"/>
                                                </rs:RangeSlider.Resources>
                                            </rs:RangeSlider>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Spacing="2">
                                                <TextBlock Name="RangeSlider2Text" Text="{Binding RangeSlider2Label}" TextAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding #LightRange2Slider2.LowerSelectedValue, StringFormat='S:{0:0}'}" Foreground="#AAA" FontSize="11"/>
                                                    <TextBlock Text="{Binding #LightRange2Slider2.UpperSelectedValue, StringFormat='E:{0:0}'}"   Foreground="#AAA" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <rs:RangeSlider x:Name="LightRange2Slider2"
                                                            Grid.Column="1"
                                                            Minimum="0" Maximum="1000"
                                                            LowerSelectedValue="{Binding Range2Slider2Lower, Mode=TwoWay}"
                                                            UpperSelectedValue="{Binding Range2Slider2Upper, Mode=TwoWay}">
                                                <rs:RangeSlider.Resources>
                                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="BlueViolet"/>
                                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="BlueViolet"/>
                                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="BlueViolet"/>
                                                </rs:RangeSlider.Resources>
                                            </rs:RangeSlider>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Block Color -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,10">
                                        <TextBlock Text="Block Color:" Foreground="White" VerticalAlignment="Center" Margin="0,10,8,10"/>

                                        <Border Width="200"
                                                Height="40"
                                                CornerRadius="8"
                                                BorderBrush="Black"
                                                BorderThickness="6"
                                                ClipToBounds="True"
                                                HorizontalAlignment="Left">
                                            <Border CornerRadius="8" Background="BlueViolet">
                                                <Canvas Name="ColorDropBox" Background="{Binding BlockColorBrush}"/>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                    
                                    
                                    <StackPanel Name="SecondColorPanel" Grid.Row="3" Orientation="Horizontal" Margin="0,10" IsVisible="{Binding SecondColorPanelVisible}">
                                    <TextBlock Name="SecondColorHeader" Text="Second Color:" Foreground="White" VerticalAlignment="Center" Margin="0,10,8,10"/>
                                    <Border Name="SecondColorFrame"
                                            Width="200"
                                            Height="40"
                                            CornerRadius="8"
                                            BorderBrush="Black"
                                            BorderThickness="6"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Left"
                                            IsVisible="True">
                                        <Border CornerRadius="8" Background="Transparent">
                                            <Canvas Name="SecondColorDropBox" Background="{Binding SecondBlockColorBrush}"/>
                                        </Border>
                                    </Border>
                                    </StackPanel>


                                    <StackPanel Name="FillColorPanel" Grid.Row="5" Orientation="Horizontal" Margin="0,10" IsVisible="{Binding FillColorPanelVisible}">
                                    <TextBlock Name="FillColorHeader" Text="Fill Color:" Foreground="White" VerticalAlignment="Center" Margin="0,10,8,10"/>
                                    <Border Name="FillColorFrame"
                                            Width="200"
                                            Height="40"
                                            CornerRadius="8"
                                            BorderBrush="Black"
                                            BorderThickness="6"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Left"
                                            IsVisible="True">
                                        <Border CornerRadius="8" Background="Transparent">
                                            <Canvas Name="FillColorDropBox" Background="{Binding FillColorBrush}"/>
                                        </Border>
                                    </Border>
                                    </StackPanel>


                                    <StackPanel Name="StrobeColorPanel" Grid.Row="6" Orientation="Horizontal" Margin="0,10" IsVisible="{Binding StrobeColorPanelVisible}">
                                    <TextBlock Name="StrobeColorHeader" Text="Strobe Color:" Foreground="White" VerticalAlignment="Center" Margin="0,10,8,10"/>
                                    <Border Name="StrobeColorFrame"
                                            Width="200"
                                            Height="40"
                                            CornerRadius="8"
                                            BorderBrush="Black"
                                            BorderThickness="6"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Left"
                                            IsVisible="True">
                                        <Border CornerRadius="8" Background="Transparent">
                                            <Canvas Name="StrobeColorDropBox" Background="{Binding StrobeColorBrush}"/>
                                        </Border>
                                    </Border>
                                    </StackPanel>


                                    <StackPanel Grid.Row="4" >
                                        <TextBlock Text="Intensity (0-255)" Foreground="White"/>
                                        <TextBox Name="IntensityInput" Width="200" HorizontalAlignment="Left"
                                                 Text="{Binding IntensityText, Mode=TwoWay}"/>

                                        <!-- Dynamic effect params: one titled input per param of each
                                             active effect, generated from the EffectCatalog schema. -->
                                        <ItemsControl Name="EffectParamsList" ItemsSource="{Binding EffectParams}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EffectParamViewModel">
                                                    <StackPanel>
                                                        <StackPanel IsVisible="{Binding IsNumberBox}">
                                                            <TextBlock Foreground="White" Text="{Binding Title}"/>
                                                            <TextBox Width="200" HorizontalAlignment="Left"
                                                                     Text="{Binding Text, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                        <CheckBox Content="{Binding Title}" Foreground="White"
                                                                  IsVisible="{Binding IsCheckBox}"
                                                                  IsChecked="{Binding BoolValue, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                                </ScrollViewer>

                            </Grid>
                        </Grid>

                </TabItem>
            </TabControl>

        </Grid>
        <ScrollViewer x:Name="BlockEditorScrollViewer"
                      Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                      Width="300"
                      IsVisible="{Binding EditorVisible}">
            <Border Name="BlockEditor"
                    Background="#222"
                    Padding="10"
                    CornerRadius="6"
                    Margin="10,0,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="Block Effects Selection"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <Border Height="1" Background="#333" Margin="0,10,0,10"/>

                    <!-- Shape: mutually exclusive, defines which pixels are lit.
                         Mixed multi-selection = no radio checked; blocks keep their own
                         shape until the user picks one. -->
                    <TextBlock Text="Shape" Foreground="White" Margin="0,10,0,0"/>
                    <StackPanel>
                        <RadioButton Content="Static"   GroupName="BlockShape" Foreground="White" IsChecked="{Binding ShapeStatic,   Mode=TwoWay}"/>
                        <RadioButton Content="Travel"   GroupName="BlockShape" Foreground="White" IsChecked="{Binding ShapeTravel,   Mode=TwoWay}"/>
                        <RadioButton Content="Combine"  GroupName="BlockShape" Foreground="White" IsChecked="{Binding ShapeCombine,  Mode=TwoWay}"/>
                        <RadioButton Content="Seperate" GroupName="BlockShape" Foreground="White" IsChecked="{Binding ShapeSeparate, Mode=TwoWay}"/>
                        <RadioButton Content="Scanner"  GroupName="BlockShape" Foreground="White" IsChecked="{Binding ShapeScanner,  Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Texture: mutually exclusive per-pixel surface modulation over the
                         lit pixels (optionally including the fill color). -->
                    <TextBlock Text="Texture" Foreground="White" Margin="0,10,0,0"/>
                    <StackPanel>
                        <RadioButton Content="None"    GroupName="BlockTexture" Foreground="White" IsChecked="{Binding TextureNone,    Mode=TwoWay}"/>
                        <RadioButton Content="Twinkle" GroupName="BlockTexture" Foreground="White" IsChecked="{Binding TextureTwinkle, Mode=TwoWay}"/>
                        <RadioButton Content="Shimmer" GroupName="BlockTexture" Foreground="White" IsChecked="{Binding TextureShimmer, Mode=TwoWay}"/>
                        <RadioButton Content="Sparkle" GroupName="BlockTexture" Foreground="White" IsChecked="{Binding TextureSparkle, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Modifiers: stackable post-passes over the shape's output. -->
                    <TextBlock Text="Effects" Foreground="White" Margin="0,10,0,0"/>
                    <StackPanel>
                        <CheckBox Content="Fade In"      Foreground="White" IsThreeState="True" IsChecked="{Binding FadeIn,       Mode=TwoWay}"/>
                        <CheckBox Content="Fade Out"     Foreground="White" IsThreeState="True" IsChecked="{Binding FadeOut,      Mode=TwoWay}"/>
                        <CheckBox Content="Strobe"       Foreground="White" IsThreeState="True" IsChecked="{Binding Strobe,       Mode=TwoWay}"/>
                        <CheckBox Content="Repeat"       Foreground="White" IsThreeState="True" IsChecked="{Binding Repeat,       Mode=TwoWay}"/>
                        <CheckBox Content="Color Change" Foreground="White" IsThreeState="True" IsChecked="{Binding ChangeColor,  Mode=TwoWay}"/>
                        <CheckBox Content="Comet"        Foreground="White" IsThreeState="True" IsChecked="{Binding Comet,        Mode=TwoWay}"/>
                        <CheckBox Content="Fill Color"   Foreground="White" IsThreeState="True" IsChecked="{Binding FillColor,    Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        
        <TextBlock Grid.Column="0" Grid.Row="3" Name="ErrorText" FontSize="14" Text="" IsVisible="False" Margin="10"/>

    </Grid>
        
</Window>
