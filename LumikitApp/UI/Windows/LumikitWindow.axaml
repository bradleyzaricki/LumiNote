<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LumikitApp.Controls"
        xmlns:rs="clr-namespace:RangeSlider.Avalonia.Controls;assembly=RangeSlider.Avalonia"
        xmlns:models="clr-namespace:LumikitApp.Models"
        x:Class="LumikitApp.LumikitWindow"
        Width="1600" Height="900"
        Background="Black"
        Title="LumiNote Software V1">
    <Window.Resources>
        <Flyout x:Key="OpenAudioFlyout" Placement="Bottom">
            <Border Background="#222" Padding="12" CornerRadius="8">
                <StackPanel Width="320" Spacing="10">
                    <TextBlock Text="Open Audio File" FontSize="16" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Choose an mp3/wav/flac file." Foreground="#AAA"/>

                    <Button Content="Browse…" Click="BrowseAudioFile_Click"/>

                    <TextBlock Name="SelectedAudioPathText"
                               Text="No file selected"
                               Foreground="#888"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Flyout>

        <Flyout x:Key="SwatchPickerFlyout" Placement="Bottom">
            <Border Background="#222" Padding="10" CornerRadius="8">
                <ColorPicker x:Name="SwatchFlyoutPicker"
                             Width="260"
                             Height="220"
                             ColorSpectrumShape="Ring"
                             IsColorSpectrumSliderVisible="False"
                             IsAlphaEnabled="False"/>
            </Border>
        </Flyout>

        <Flyout x:Key="HardwareSettingsFlyout" Placement="Bottom">
            <Border Background="#222" Padding="12" CornerRadius="8">
                <StackPanel Width="280" Spacing="10">

                    <TextBlock Text="Hardware Settings" FontSize="16" FontWeight="Bold" Foreground="White"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Number Leds" Foreground="#DDD"/>
                        <TextBox Watermark="ex. 300 LEDS" Name="ActiveLightsTextBox"></TextBox>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Input Current" Foreground="#DDD"/>

                            <Slider Name="HardwareCurrentSlider"
                                    Minimum="0"
                                    Maximum="40"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"/>

                            <TextBlock Text="{Binding #HardwareCurrentSlider.Value, StringFormat={}{0:0} A}"
                                       HorizontalAlignment="Left"
                                       Foreground="#AAA"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="USB / Serial Device"/>

                        <ComboBox Name="PortComboBox"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Refresh" Click="RefreshPorts"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Save Changes" Foreground="#DDD"/>
                        <Button Content="Save" Width="80" Click="SaveHardwareSettings"></Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Flyout>
    </Window.Resources>

    <Grid x:Name="MainGrid" ColumnDefinitions="*, Auto" RowDefinitions="Auto,Auto,*,Auto" Margin="10">

        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <Button Name="PauseTrackButton" Content="Pause" Width="80"/>
            <Button Name="ResumeTrackButton" Content="Resume" Width="80"/>
            <Button Name="NextTrackButton" Content="Next" Width="80"/>
            <Button Name="RestartTrackButton" Content="Restart" Width="80"/>
            <Button Name="ZoomInButton" Content="+" Width="40"/>
            <Button Name="ZoomOutButton" Content="-" Width="40"/>

            <TextBlock Name="StopwatchLabel" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBlock Text="BPM:" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBox Name="BpmInput" Width="60" Text="120"/>
            <Button Name="SaveTrackDataButton" Content="Save New" Width="100"/>
            <Button Name="OpenAudioFileButton"
                    Content="New Lightmap"
                    Width="250"
                    Click="OpenAudioFileButton_OnClick"/>

            <Button Name="HardwareSettings"
                    Content="Hardware Settings"
                    Width="150"
                    Background="BlueViolet"
                    Click="HardwareSettingsOnClick"
                    Flyout="{StaticResource HardwareSettingsFlyout}"/>
            <TextBlock Name="HardwareConnectionText" Text="Serial Disconnected" VerticalAlignment="Center"></TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Image Name="AlbumArt" Width="60" Height="60"/>

            <StackPanel Orientation="Vertical" Margin="10,0,0,0">
                <TextBlock Text="title:" Foreground="White" FontSize="8"/>
                <TextBlock Name="NowPlayingTrackText" Foreground="White" FontSize="16"/>

                <TextBlock Text="artist:" Foreground="White" FontSize="8" Margin="0,4,0,0"/>
                <TextBlock Name="NowPlayingArtistText" Foreground="White" FontSize="16"/>
            </StackPanel>

            <Image Name="SpotifyAttributionLogo"
                   Source="avares://LumikitApp/Icons/spot_white_logo_full.png"
                   Width="120"
                   
                   Margin="30,0,10,10"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   IsVisible="True"/>
        </StackPanel>

        <Grid Grid.Column="0" Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

            <Border Grid.Row="0" Name="TopColorBar" Height="5" Background="Gray"/>

            <ScrollViewer Grid.Row="1"
                          Name="TimelineScrollViewer"
                          HorizontalScrollBarVisibility="Visible"
                          VerticalScrollBarVisibility="Disabled"
                          Height="130">
                <Grid>
                    <Canvas Name="TimelineCanvas" Height="80" Margin="0,20,0,0"/>
                    <Canvas Name="BpmCanvas" Height="80" Margin="0,20,0,0" IsHitTestVisible="False"/>
                    <Canvas Name="SeekBarCanvas" Height="20" VerticalAlignment="Top" Background="#337F77DD"/>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Name="BottomColorBar" Height="5" Background="Gray"/>

            <WrapPanel Grid.Row="3"
                       Name="ColorPalette"
                       Orientation="Horizontal"
                       Margin="0,10,0,0"
                       Height="40"/>

            <Border Grid.Row="4" Height="1" Background="#333" Margin="0,20,0,10"/>
            

            <TabControl x:Name="MainTabControl" Grid.Row="6">
                <TabItem Header="Tracks" Margin="0,10,0,0">
                    <TabControl>
                        <TabItem Header="Local Tracks" Margin="0,10,0,0">
                        <Grid Margin="0,0,0,0" RowDefinitions="Auto,*">

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox x:Name="LocalTrackSearchBox"
                                         Width="320"
                                         Watermark="Search tracks by name or ID..."
                                         HorizontalAlignment="Left"
                                         TextChanged="LocalTrackSearchBox_TextChanged"/>

                                <Button Content="Refresh"
                                        Width="100"
                                        HorizontalAlignment="Left"
                                        Click="RefreshLocalTracks_Click"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="#1b1b1b"
                                    CornerRadius="6"
                                    Padding="10">

                                <ListBox x:Name="LocalTracksListBox"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </ListBox.Styles>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TrackItemUI">
                                            <Border Background="{Binding Color, Converter={StaticResource DarkenConverter}}"
                                                    CornerRadius="6"
                                                    Padding="12"
                                                    Margin="0,0,0,0"
                                                    Height="64"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{Binding Color}">
                                                <Grid ColumnDefinitions="*,Auto,Auto, Auto"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch">

                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TrackName}"
                                                                   Foreground="White"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   Foreground="#9a9a9a"
                                                                   FontSize="12"/>
                                                    </StackPanel>
                                                    <Button Content="+"
                                                            Grid.Column="2"
                                                            Width="40"
                                                            Height="32"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            Click="LocalTrack_Upload_Click"/>
                                                    <Button Content="▶"
                                                            Grid.Column="1"
                                                            Width="40"
                                                            Height="32"
                                                            Margin="12,0,8,0"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            Click="LocalTrack_Play_Click"/>

                                                    <Button Content="🗑"
                                                            Grid.Column="3"
                                                            Width="40"
                                                            Height="32"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            Click="LocalTrack_Delete_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </Border>

                        </Grid>
                    </TabItem>
                        


        <!-- Downloaded Local Tracks -->
            


            <!-- QUEUE -->
            <TabItem Header="Queue">
                <Border Background="#1b1b1b"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,10,0,0">
                    <ListBox x:Name="QueueTracksListBox">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackItemUI">
                                <Grid ColumnDefinitions="*,Auto" Margin="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox x:Name="QueueTrackSearchBox"
                                 Width="320"
                                 Watermark="Search tracks by name or ID..."
                                 HorizontalAlignment="Left"
                                 TextChanged="LocalTrackSearchBox_TextChanged"/>

                        <Button Content="Refresh"
                                Width="100"
                                HorizontalAlignment="Left"/>
                    </StackPanel>

       

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>
        
            <!-- DB TRACKS -->
            <TabItem Header="Download Tracks">
                <Grid Margin="0,10,0,0" RowDefinitions="Auto,*" ColumnSpacing="10">

                    <!-- Search + Refresh ABOVE LIST, LEFT ALIGNED -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="0">
                        <TextBox Width="320"
                                 Watermark="Search tracks..."
                                 HorizontalAlignment="Left"/>
                        <Button Content="Refresh"
                                Width="100"
                                HorizontalAlignment="Left"                                
                                Click="DatabaseTrack_Refresh_Click"/>
                    </StackPanel>

                    <!-- Scrollable List -->
                    <Border Grid.Row="1"
                            Background="#1b1b1b"
                            CornerRadius="6"
                            Padding="10">
                        <ListBox x:Name="DatabaseTracksListBox"  
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TrackItemUI">
                                    <Border Background="{Binding Color, Converter={StaticResource DarkenConverter}}"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,0"
                                            Height="64"
                                            BorderThickness="1.5"
                                            BorderBrush="{Binding Color}">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TrackName}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#9a9a9a" FontSize="12"/>
                                            </StackPanel>
                                            <Button Content="+" Grid.Column="1"
                                                    Width="40"
                                                    Height="32"
                                                    Margin="12,0,8,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Click="DatabaseTrack_Download_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                </Grid>
            </TabItem>
            </TabControl>
            </TabItem>
                <TabItem Header="Light Preview" Margin="0,10,0,0">

                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Top controls -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="10"
                                    Spacing="10">

                            <Button Content="Play Preview"
                                    Click="PlayPreview_Click"/>

                            <Button Content="Stop Preview"
                                    Click="StopPreview_Click"/>

                            <TextBlock Text="Selected Block Simulator"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="10" Background="#222">

                            <!-- LED BACKGROUND -->
                            <local:LedStripPreview
                                x:Name="LedPreview"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>

                            <!-- LIGHTBLOCK SETTINGS -->
                            <Grid HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top"
                                  Margin="30,25"
                                  Height="300"
                                  ZIndex="10"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                
                                <!-- LIGHTSPAN -->
                                
                                <StackPanel  Name="LightRange" Grid.Row="0" Margin="0,10" IsVisible="False">
                                    <TextBlock Text="LightSpan"/>
                                    <rs:RangeSlider x:Name="LightRangeSlider"
                                                    Minimum="0" Maximum="1000"
                                                    LowerSelectedValue="100" UpperSelectedValue="200">
                                        <rs:RangeSlider.Resources>
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="BlueViolet"/>
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="BlueViolet"/>
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="BlueViolet"/>
                                        </rs:RangeSlider.Resources>
                                    </rs:RangeSlider>
                                </StackPanel>
                                
                                <!-- LIGHTSPAN 2In1 -->

                                <StackPanel Name="LightRange2" Grid.Row="1" Margin="0,10" Spacing="6" IsVisible="False">

                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   TextAlignment="Center"
                                                   Text="Start Lightspan"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,10,0"/>
                                        <rs:RangeSlider x:Name="LightRange2Slider1"
                                                        Grid.Column="1"
                                                        Minimum="0" Maximum="1000"
                                                        LowerSelectedValue="100" UpperSelectedValue="200">
                                            <rs:RangeSlider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="BlueViolet"/>
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="BlueViolet"/>
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="BlueViolet"/>
                                            </rs:RangeSlider.Resources>
                                        </rs:RangeSlider>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Padding="0,10,0,0"
                                                   TextAlignment="Center"
                                                   Text="End Lightspan"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <rs:RangeSlider x:Name="LightRange2Slider2"
                                                        Grid.Column="1"
                                                        Minimum="0" Maximum="1000"
                                                        LowerSelectedValue="100" UpperSelectedValue="200">
                                            <rs:RangeSlider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="BlueViolet"/>
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="BlueViolet"/>
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="BlueViolet"/>
                                            </rs:RangeSlider.Resources>
                                        </rs:RangeSlider>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Block Color -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,10">
                                    <TextBlock Text="Block Color:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <Border Width="200"
                                            Height="40"
                                            CornerRadius="8"
                                            BorderBrush="Black"
                                            BorderThickness="6"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Left">
                                        <Border CornerRadius="8" Background="BlueViolet">
                                            <Canvas Name="ColorDropBox"/>
                                        </Border>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10">
                                    
                                    <!-- Secondary Color  -->
                                <TextBlock Name="SecondColorHeader" Text="Second Color:" Foreground="White" IsVisible="True"/>
                                <Border Name="SecondColorFrame"
                                        Width="200"
                                        Height="40"
                                        CornerRadius="8"
                                        BorderBrush="Black"
                                        BorderThickness="6"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Left"
                                        IsVisible="True">
                                    <Border CornerRadius="8" Background="Transparent">
                                        <Canvas Name="SecondColorDropBox"/>
                                    </Border>
                                </Border>
                                </StackPanel>

                            </Grid>

                        </Grid>
                    </Grid>
 
                </TabItem>
            </TabControl>

        </Grid>
        <ScrollViewer x:Name="BlockEditorScrollViewer"
                      Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                      Width="300"
                      IsVisible="False">
            <Border Name="BlockEditor"
                    Background="#222"
                    Padding="10"
                    CornerRadius="6"
                    Margin="10,0,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="Block Editor"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                   

                    <Border Height="1" Background="#333" Margin="0,10,0,10"/>

                    <TextBlock Text="Intensity (0-255)" Foreground="White"/>
                    <TextBox Name="IntensityInput"/>

                    <StackPanel Name="AdditionalSingleInputPanel1">
                        <TextBlock Name="AdditionalSingleInputLabel1" Text="SECONDARYSINGLEINPUT" Foreground="White"/>
                        <TextBox Name="AdditionalSingleInput1TextBox"/>
                    </StackPanel>

                    <StackPanel Name="AdditionalSingleInputPanel2">
                        <TextBlock Name="AdditionalSingleInputLabel2" Text="" Foreground="White"/>
                        <TextBox Name="AdditionalSingleInput2TextBox"/>
                    </StackPanel>

                   

                    <TextBlock Text="Effect" Foreground="White" Margin="0,10,0,0"/>
                    <StackPanel>
                        <CheckBox Name="Effect_FadeIn" Content="Fade In" Foreground="White"/>
                        <CheckBox Name="Effect_FadeOut" Content="Fade Out" Foreground="White"/>
                        <CheckBox Name="Effect_FadeStrobe" Content="Strobe" Foreground="White"/>
                        <CheckBox Name="Effect_Travel"
                                  Content="Travel"
                                  Foreground="White"
                                  Checked="Effect_Travel_Checked"
                                  Unchecked="Effect_OnChanged"/>
                        <CheckBox Name="Effect_Combine"
                                  Content="Combine"
                                  Foreground="White"
                                  Checked="Effect_Combine_OnChecked"
                                  Unchecked="Effect_OnChanged"/>
                        <CheckBox Name="Effect_Seperate"
                                  Content="Seperate"
                                  Foreground="White"
                                  Checked="Effect_Seperate_OnChecked"
                                  Unchecked="Effect_OnChanged"/>
                        <CheckBox Name="Effect_Repeat"
                                  Content="Repeat"
                                  Foreground="White"
                                  Checked="Effect_OnChanged"
                                  Unchecked="Effect_OnChanged"/>
                        <CheckBox Name="Effect_ChangeColor"
                                  Content="Color Change"
                                  Foreground="White"
                                  Checked="Effect_OnChanged"
                                  Unchecked="Effect_OnChanged"/>

                        <CheckBox Name="Effect_Twinkle"
                                  Content="Twinkle"
                                  Foreground="White"
                                  Checked="Effect_OnChanged"
                                  Unchecked="Effect_OnChanged"/>
                    </StackPanel>

                    <Button Name="ApplyBlockChangesButton"
                            Content="Apply"
                            Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        
        <TextBlock Grid.Column="0" Grid.Row="3" Name="ErrorText" FontSize="14" Text="" IsVisible="False" Margin="10"/>

    </Grid>
        
</Window>
