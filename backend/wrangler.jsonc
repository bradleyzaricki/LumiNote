{
  "name": "worker1",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-01-10",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "lightmaps",
      "bucket_name": "luminote-lightmaps"
    }
  ],
  "d1_databases": [
    {
      "binding": "trackInfo",
      "database_id": "162626bd-0de1-45cb-84b6-f61ba678aa89"
    }
  ]
}