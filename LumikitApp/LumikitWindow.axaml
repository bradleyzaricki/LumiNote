<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LumikitApp.LumikitWindow"
        Width="1600" Height="900"
        Background="Black"
        Title="Lumikit">

    <Grid ColumnDefinitions="*, 200" RowDefinitions="Auto,Auto,*" Margin="10">

        <!-- LEFT SIDE: playback, track info, timeline -->
        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <Button Name="PauseTrackButton" Content="Pause" Width="80"/>
            <Button Name="ResumeTrackButton" Content="Resume" Width="80"/>
            <Button Name="NextTrackButton" Content="Next" Width="80"/>
            <Button Name="RestartTrackButton" Content="Restart" Width="80"/> <!-- NEW -->
            <Button Name="ZoomInButton" Content="+" Width="40"/>
            <Button Name="ZoomOutButton" Content="-" Width="40"/>

            <TextBlock Name="StopwatchLabel" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBlock Text="BPM:" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBox Name="BpmInput" Width="60" Text="120" />
            <Button Name="SaveTrackDataButton" Content="Save" Width="80"/>
        </StackPanel>


        <!-- Track Info -->
        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Image Name="AlbumArt" Width="60" Height="60"/>
            <TextBlock Name="NowPlayingText" Foreground="White" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Timeline + Palette -->
        <StackPanel Grid.Column="0" Grid.Row="2">
            <Border Name="TopColorBar" Height="5" Background="Gray"/>
            <ScrollViewer Name="TimelineScrollViewer"
                          HorizontalScrollBarVisibility="Visible"
                          VerticalScrollBarVisibility="Disabled"
                          Height="130">
                <Grid>
                    <!-- Block Layer -->
                    <Canvas Name="TimelineCanvas" Height="80"/>

                    <!-- BPM Overlay Layer -->
                    <Canvas Name="BpmCanvas" Height="80"
                            IsHitTestVisible="False"/> <!-- overlay, mouse ignores it -->
                </Grid>
            </ScrollViewer>

            <Border Name="BottomColorBar" Height="5" Background="Gray"/>
            <WrapPanel Name="ColorPalette"
                       Orientation="Horizontal"
                       Margin="0,10,0,0"
                       Height="40"/>
        </StackPanel>

        <!-- RIGHT SIDE: Block Editor spanning all rows -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                Background="#222"
                Padding="10"
                CornerRadius="6"
                Margin="10,0,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="Block Editor"
                           Foreground="White"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Start Light (0-100)" Foreground="White"/>
                <TextBox Name="StartLightInput"/>

                <TextBlock Text="End Light (0-100)" Foreground="White"/>
                <TextBox Name="EndLightInput"/>
                
                <TextBlock Text="Intensity (0-255)" Foreground="White"/>
                <TextBox Name="IntensityInput"/>
                
                <StackPanel Name="TravelInputsPanel">
                    <TextBlock Text="Ending Start Light (0-100)" Foreground="White"/>
                    <TextBox Name="TravelStartLightInput"/>
                    
                    <TextBlock Text="Ending End Light (0-100)" Foreground="White"/>
                    <TextBox Name="TravelEndLightInput"/>
                    </StackPanel>

    
                
                <!-- Effect Options -->
                <TextBlock Text="Effect" Foreground="White" Margin="0,10,0,0"/>
                <StackPanel>
                    <CheckBox Name="Effect_None" Content="None" Foreground="White" IsChecked="True"/>
                    <CheckBox Name="Effect_FadeIn"  Content="Fade In" Foreground="White"/>
                    <CheckBox Name="Effect_FadeOut"  Content="Fade Out" Foreground="White"/>
                    <CheckBox Name="Effect_FadeStrobe" Content="Strobe" Foreground="White"/>
                    <CheckBox Name="Effect_Travel"
                              Content="Travel"
                              Foreground="White"
                              Checked="Effect_Travel_Checked"
                              Unchecked="Effect_Travel_Unchecked"/>
                    
                    <CheckBox Name="Effect_Combine" Content="Combine" Foreground="White"/>
                    <CheckBox Name="Effect_Build"  Content="Build" Foreground="White"/>
                    <CheckBox Name="Effect_Seperate" Content="Seperate" Foreground="White"/>
                    <CheckBox Name="Effect_AccentColor"  Content="Accent Color" Foreground="White"/>
                    <CheckBox Name="Effect_FillerColor" Content="Filler Color" Foreground="White"/>
                </StackPanel>

                <Button Name="ApplyBlockChangesButton"
                        Content="Apply"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
