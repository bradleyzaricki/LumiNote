<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LumikitApp.ProviderPickerWindow"
        Width="560"
        Height="420"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Title="Choose playback"
        Background="#2E2E2E">

    <Window.Styles>
        <!-- Highlight the tile when its provider is enabled -->
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="ToggleButton:checked">
            <Setter Property="BorderBrush" Value="#1DB954"/>
            <Setter Property="Background" Value="#454545"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0"
                   FontSize="18"
                   Text="Select your playback sources"
                   Foreground="White"
                   HorizontalAlignment="Center"/>

        <!-- Tiles are generated from ProviderMetadata.All in code-behind, so adding a provider
             needs no change to this file. -->
        <ItemsControl Grid.Row="1"
                      Name="ProviderList"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,20,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="24"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock Grid.Row="2"
                   Name="HintText"
                   Foreground="#FFD86B"
                   FontSize="11"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,12,0,0"
                   IsVisible="False"/>

        <Button Grid.Row="3"
                Name="ContinueButton"
                Content="Continue"
                HorizontalAlignment="Center"
                Padding="24,8"
                Margin="0,16,0,0"
                IsEnabled="False"
                Click="Continue_Click"/>
    </Grid>

</Window>
