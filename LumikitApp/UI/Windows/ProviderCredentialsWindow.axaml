<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LumikitApp.ProviderCredentialsWindow"
        Width="520"
        Height="580"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Connect a music source"
        Background="#2E2E2E">

    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Image Name="ProviderIcon" Width="40" Height="40" Stretch="Uniform"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Name="HeadingText" Classes="heading"/>
                <Border Name="ExperimentalBadge"
                        Background="#7A5C00"
                        CornerRadius="8"
                        Padding="8,2"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        IsVisible="False">
                    <TextBlock Text="EXPERIMENTAL" Foreground="#FFD86B" FontSize="9" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="#444" Margin="0,16,0,16"/>

        <ScrollViewer Grid.Row="2">
            <TextBlock Name="InstructionsText" Classes="body"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,16,0,0" Spacing="6">
            <TextBlock Classes="label" Text="Redirect URI — paste this into the dashboard"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Name="RedirectUriBox"
                         Width="360"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"/>
                <Button Name="CopyRedirectButton"
                        Content="Copy"
                        Padding="14,4"
                        Click="CopyRedirect_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,14,0,0" Spacing="6">
            <TextBlock Name="CredentialLabelText" Classes="label"/>
            <TextBox Name="ClientIdBox"
                     Watermark="Paste it here"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextChanged="ClientId_TextChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="5"
                   Name="ErrorText"
                   Foreground="#FF7A7A"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   IsVisible="False"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button Name="OpenPortalButton"
                    Content="Open Dashboard"
                    Padding="16,6"
                    Click="OpenPortal_Click"/>
            <Button Name="RemoveButton"
                    Content="Remove"
                    Padding="16,6"
                    IsVisible="False"
                    Click="Remove_Click"/>
            <Button Name="CancelButton"
                    Content="Cancel"
                    Padding="16,6"
                    Click="Cancel_Click"/>
            <Button Name="SaveButton"
                    Content="Save"
                    Padding="20,6"
                    IsEnabled="False"
                    Foreground="Black"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
